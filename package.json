{
  "name": "daymark",
  "version": "1.0.0",
  "private": true,
  "description": "Date & week calculator with a private cooperative reference: investment series and member grades.",
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:pages": "cross-env STATIC_EXPORT=1 PAGES_BASE_PATH=/daymark NEXT_PUBLIC_BASE_PATH=/daymark next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "date-fns": "^4.1.0",
    "next": "^15.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "cross-env": "^10.1.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
